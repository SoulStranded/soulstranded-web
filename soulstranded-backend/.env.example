# 数据库连接配置
# MySQL 连接字符串
DATABASE_URL=mysql://your_username_or_root:your_password@127.0.0.1:3306/soulstranded

# redis 连接配置
REDIS_URL=redis://127.0.0.1:6379

# 服务器配置
PORT=3000
HOST=0.0.0.0

# 邮箱配置（用于注册、找回密码等）
SMTP_URL=smtp.your-email-provider.com
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=<your_app_password_or_smtp_password>

# JWT 配置（用于用户认证）
JWT_SECRET=<a_long_random_secret_string>
JWT_EXPIRATION_HOURS=24
JWT_REMEMBER_EXPIRATION_HOURS=720

# 上传文件路径
UPLOAD_DIR=./uploads
